# ==============================================================================
# POINT DO COCO LAVA JATO — VARIÁVEIS DE AMBIENTE
# ==============================================================================

# URL do seu projeto Supabase (obtenha em Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co

# Chave anônima pública (segura para o navegador com RLS ativado)
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-publica-aqui

# Chave secreta de serviço (OPCIONAL - USAR SOMENTE NO SERVIDOR, NUNCA EXPOR)
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role-secreta-aqui
